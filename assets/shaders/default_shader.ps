#version 330 core
in vec3 normal;
in vec2 texcoord;
out vec4 FragColor;
vec3 lightDir = vec3(0.707, 0.707, 0.0);

uniform sampler2D texture1;

void main()
{
    float diff = max(dot(normal, lightDir) * 0.5 + 0.5, 0.1);
    vec4 texcolor = texture(texture1, texcoord);
    FragColor = diff * texcolor;
}