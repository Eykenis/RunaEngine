#version 330 core
in vec3 worldPos;
in vec3 camPos;
out vec4 FragColor;

vec3 baseColor = vec3(0.1, 0.1, 0.1);
vec3 lineColor = vec3(1.0, 1.0, 1.0);
float gridSize = 0.5;

void main()
{
    vec2 coord = worldPos.xz / gridSize;

    vec2 grid = abs(fract(coord - 0.5) - 0.5) / fwidth(coord);
    float line = min(grid.x, grid.y);

    float alpha = 1.0 - smoothstep(0.0, 1, line);
    if (alpha < 0.02)
        discard;
    vec3 color = mix(baseColor, lineColor, alpha);

    float fade = clamp(1.0 - distance(worldPos, camPos) / 12.0, 0.0, 1.0);
    if (fade < 0.01)
        discard;

    FragColor = vec4(color, fade);
}
