#version 330 core
in vec2 texcoord;
in vec4 worldPos;
in vec3 normal;
out vec4 fragcolor;

uniform sampler2D texture1;

uniform vec3 lightPos;
uniform vec3 camPos;
vec3 lightColor = vec3(1.0, 1.0, 1.0);
float metallic = 0.07;
float roughness = 0.45;
float exposure = 1.0;
float PI = 3.141593;

// 根据粗糙度计算方向一致微平面比率
float D(vec3 N, vec3 H, float a)
{
    float a2 = a * a;
    float NpH = max(dot(N, H), 0.0);
    float NpH2 = NpH * NpH;
    float denom = (NpH2 * (a2 - 1) + 1);
    float denom2 = denom * denom;
    return a2 / (denom2 * PI);
}

// 应用微平面相互遮蔽比率
float G(vec3 N, vec3 V, vec3 L, float k)
{
    float NV = max(dot(N, V), 0.0);
    float NL = max(dot(N, L), 0.0);
    return NV / (NV * (1.0 - k) + k) * NL / (NL * (1.0 - k) + k);
}

// 菲涅尔方程，反射折射比率
vec3 F(vec3 F0, vec3 H, vec3 V)
{
    return F0 + (1.0 - F0) * pow(1.0 - dot(H, V), 5.0);
}

void main()
{
    vec3 lightDir = normalize(lightPos - worldPos.xyz);
    vec3 V = normalize(camPos - worldPos.xyz);
    vec3 N = normalize(normal);
    vec3 L = normalize(lightDir);
    vec3 H = normalize(V + L);
    float fragDis = length(lightPos - worldPos.xyz);
    float atten = 1.0 / (fragDis * fragDis);
    vec3 radiance = lightColor * 1.0;

    vec3 albedo = pow(texture(texture1, texcoord).rgb, vec3(2.2));
    vec3 F0 = mix(vec3(0.04), albedo, metallic);

    float alpha = roughness * roughness;
    float g_k = (alpha + 1.0) * (alpha + 1.0) / 8.0;
    float D_value = D(N, H, alpha);
    float G_value = G(N, V, L, g_k);
    vec3 F_value = F(F0, H, V);

    vec3 ks = F_value;
    vec3 kd = vec3(1.0) - ks;
    kd *= 1.0 - metallic;

    vec3 specular = D_value * F_value * G_value / (4.0 * max(dot(N, V), 0.0) * max(dot(N, L), 0.0) + 0.001);
    vec3 Lo = ((kd * albedo) + specular) * max(dot(N, L), 0) * radiance * exposure;
    vec3 ambient = vec3(0.01) * albedo;
    vec3 color = Lo + ambient;
//    color = color / (color + vec3(1.0));
    color = vec3(1.0) - exp(-(Lo + ambient));
    color = pow(color, vec3(1.0 / 2.2));

    fragcolor = vec4(color, 1.0);
}